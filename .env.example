# Copy to .env and adjust. All paths are relative to the project root.
PORT=3000
HOST=0.0.0.0
DB_FILE=data/pasar-keripik.db
UPLOAD_DIR=data/uploads
CLIENT_DIST=client/dist
# Default UI/API language when the request does not say (id | en). Seeded into settings.default_language.
DEFAULT_LANG=id
# Max size per uploaded photo (MB)
MAX_UPLOAD_MB=5

# Phase 1 "current user" (no login yet). Phase 2 replaces this with JWT.
PHASE1_USERID=admin1
# First-run seed values (only used when the rows do not exist yet)
SEED_ADMIN_USERID=admin1
SEED_ADMIN_NAME=admin pasar keripik
SEED_SHOP_NAME=Pasar Keripik

# 1 = log every request with its duration
LOG_REQUESTS=0
